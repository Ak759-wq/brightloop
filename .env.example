# ---- Firebase web (public client config; safe to expose to the browser) ----
# Leave all NEXT_PUBLIC_FIREBASE_* empty to run with built-in LOCAL auth (dev/demo only).
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ---- Server (never exposed) ----
# Full service-account JSON on ONE line. When set, data lives in Firestore via firebase-admin.
# When empty, the server uses a LOCAL JSON file store (.data/) and the UI shows a "Local mode" badge.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Shared secret the scheduler (GitHub Actions) sends as `x-cron-secret` to POST /api/billing/run
CRON_SECRET=change-me-long-random-string
# Signs local-mode session tokens (local auth only)
LOCAL_AUTH_SECRET=change-me-another-long-random-string
# Where the local JSON store is written (default .data; use /tmp/brightloop on serverless)
LOCAL_DATA_DIR=

# ---- Optional ----
# AI assistant: if set, an LLM picks the whitelisted tool; numbers always come from the tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# Payments: Razorpay adapter is stubbed; the Payment Simulator is used while these are empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email: invoices are "sent" as logged notifications unless a provider key is set.
RESEND_API_KEY=
EMAIL_FROM=billing@example.com
